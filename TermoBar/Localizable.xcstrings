    "As atualizações vêm do GitHub e são conferidas pela assinatura antes de instalar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates come from GitHub and their signature is verified before installing."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As atualizações vêm do GitHub e são conferidas pela assinatura antes de instalar."
          }
        }
      }
    },
    "As leituras finas ficam 24 horas; depois disso fica o resumo por minuto. Tudo fica só neste Mac, sem envio de dados.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detailed readings are kept for 24 hours; after that, only the per-minute summary remains. Everything stays on this Mac, and no data is sent anywhere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As leituras finas ficam 24 horas; depois disso fica o resumo por minuto. Tudo fica só neste Mac, sem envio de dados."
          }
        }
      }
    },
    "As notificações estão funcionando.": {
      "localizations": {
