    "%@ é o app que mais aquece: %@ em média, %@ da energia dos apps.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is heating up the most: %2$@ on average, %3$@ of app energy."
