          }
        }
      }
    },
    "Autonomia no ritmo dos últimos %lld min (%@). Muda conforme o que você faz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime at the pace of the last %1$lld min (%2$@). It changes with what you do."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Autonomia no ritmo dos últimos %lld min (%@). Muda conforme o que você faz."
          }
        }
      }
    },
    "Avisa quando a temperatura fica acima do limite por 30 segundos seguidos.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifies you when the temperature stays above the limit for 30 seconds in a row."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisa quando a temperatura fica acima do limite por 30 segundos seguidos."
          }
        }
      }
    },
    "Avisa quando o macOS reduz a velocidade do chip por calor (pressão térmica pesada ou crítica).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifies you when macOS slows the chip down because of heat (heavy or critical thermal pressure)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisa quando o macOS reduz a velocidade do chip por calor (pressão térmica pesada ou crítica)."
          }
        }
      }
    },
    "Avisa quando um app gasta mais que o limite, em média, durante o período escolhido. Na bateria, o aviso diz quanto da carga ele tira por hora.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts when an app uses more than the limit, on average, over the chosen period. On battery, the alert says how much charge it takes per hour."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisa quando um app gasta mais que o limite, em média, durante o período escolhido. Na bateria, o aviso diz quanto da carga ele tira por hora."
          }
        }
      }
    },
